  "fixed_sql": [
    {
      "name": "properties",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"properties\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"address\" TEXT NULL, \"owner_name\" TEXT NULL, \"owner_contact\" TEXT NULL, \"is_primary\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_primary\" IN (0, 1)), \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "room_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"room_types\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "rooms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rooms\" (\"id\" TEXT NOT NULL, \"property_id\" TEXT NOT NULL REFERENCES properties (id), \"room_type_id\" TEXT NOT NULL REFERENCES room_types (id), \"name\" TEXT NOT NULL, \"capacity\" INTEGER NOT NULL, \"rate_per_person_weekday_cents\" INTEGER NOT NULL, \"rate_per_person_weekend_cents\" INTEGER NOT NULL, \"rate_per_person_holiday_cents\" INTEGER NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "guests",
      "sql": [
